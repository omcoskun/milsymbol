{
  "name": "milsymbol",
  "version": "3.0.5-v5",
  "description": "Milsymbol.js is a small library in pure javascript that creates symbols according to MIL-STD-2525 and APP6.",
  "type": "module",
  "exports": {
    ".": {
      "require": "./dist/milsymbol.js",
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/milsymbol.js",
  "module": "./index.js",
  "browser": "./dist/milsymbol.js",
  "types": "./index.d.ts",
  "files": [
    "./dist",
    "./src",
    "./index.js",
    "./index.mjs",
    "./index.d.ts"
  ],
  "scripts": {
    "studio:build": "rollup -c && npm run minify && npm run postbuild && node scripts/build-studio.mjs",
    "studio:build:public": "rollup -c && npm run minify && npm run postbuild && node scripts/build-studio.mjs --public",
    "studio:serve": "node scripts/serve-studio.mjs",
    "lint": "eslint src test studio app/src",
    "prebuild": "npm run lint && npm test",
    "build": "npm run bundle && npm run minify",
    "postbuild": "node --eval \"const fs = require('node:fs'); fs.writeFileSync('./dist/package.json', JSON.stringify({ type: 'commonjs' }));\"",
    "bundle": "rollup -c",
    "minify": "uglifyjs dist/milsymbol.development.js -o dist/milsymbol.js --comments --compress --mangle --source-map",
    "test": "tead --coverage",
    "test:node": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omcoskun/milsymbol.git"
  },
  "author": "Måns Beckman (http://www.spatialillusions.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/omcoskun/milsymbol/issues"
  },
  "homepage": "https://github.com/omcoskun/milsymbol#readme",
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "flag-icons": "7.6.0",
    "mil-std-2525": "^0.2.8",
    "milstandard-e": "^0.2.14",
    "milsymbol-upstream": "npm:milsymbol@3.0.5",
    "prettier": "^3.8.1",
    "rollup": "^4.59.0",
    "stanag-app6": "^0.2.0",
    "tead": "^0.7.1",
    "uglify-js": "^3.19.3"
  }
}
